{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moohsia-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Empty. Invites are pasted one at a time in the admin approve form
  // and emailed to that applicant. Do not put an invite URL here or in git.
  // This flag only answers inviteConfigured. The site never prints the URL.
  "vars": {
    "DISCORD_INVITE_URL": "",
    "ADMIN_USERNAME": "htw0702"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Production D1 from `npx wrangler d1 create moohsia-cms`.
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "moohsia-cms",
      "database_id": "2da65965-5769-4643-85e4-aa2340968d44",
      "migrations_dir": "migrations"
    }
  ],
  // Login lockout uses this when present, and an in-isolate counter otherwise.
  "kv_namespaces": [
    {
      "binding": "CMS_KV",
      "id": "8a4e759892304f2882e47407ec3f0562"
    }
  ],
  // Highlight uploads. Create the bucket once, then leave this binding in place:
  //   npx wrangler r2 bucket create moohsia-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "moohsia-media"
    }
  ],
  // Daily 18:15 UTC (02:15 Taipei). Pulls Notion into the CMS draft and
  // refreshes the official hero/mode catalog in D1/KV. It does not publish.
  "triggers": {
    "crons": ["15 18 * * *"]
  }
  // Custom domains are attached in the Cloudflare dashboard (or by uncommenting
  // after the moohsia.com zone is on this account). Do not route this Worker
  // over the existing `moohsia-cloud` AI/chat API. Add admin.moohsia.com on
  // this Worker only; leave apex and www in place.
  // "routes": [
  //   { "pattern": "moohsia.com", "custom_domain": true },
  //   { "pattern": "www.moohsia.com", "custom_domain": true },
  //   { "pattern": "admin.moohsia.com", "custom_domain": true }
  // ]
}
