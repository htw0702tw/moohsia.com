{
  "name": "moohsia-com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "test": "node --test --test-concurrency=1",
    "types": "wrangler types worker/env.d.ts",
    "cms:hash": "node scripts/hash-admin-password.mjs",
    "cms:migrate:local": "wrangler d1 migrations apply moohsia-cms --local",
    "cms:migrate": "wrangler d1 migrations apply moohsia-cms --remote",
    "catalog:refresh": "node scripts/refresh-aov-catalog.mjs"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "wrangler": "^4.40.0"
  }
}
