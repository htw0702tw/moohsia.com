# Copy to .dev.vars for local `wrangler dev` / `npm start`.
# This file is an example. Do not put a real password or session secret in git.
# Leave the invite empty until the owner supplies one.
# Accepted shapes (never commit the real value):
#   https://discord.gg/<code>
#   https://discord.com/invite/<code>
DISCORD_INVITE_URL=

# Private admin at admin.localhost / admin.moohsia.com.
# The only username is htw0702. Do not put a password in this file.
# Generate the password hash with `npm run cms:hash`, then paste it here.
# Generate a session secret with `openssl rand -base64 32`.
ADMIN_USERNAME=htw0702
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Notion editorial sync. Leave blank until the owner creates the databases.
# Secrets in production: NOTION_TOKEN, NOTION_WEBHOOK_SECRET, and the database IDs.
# Do not commit a token. Sync writes the CMS draft; it does not publish the site.
NOTION_TOKEN=
NOTION_WEBHOOK_SECRET=
NOTION_ROSTER_DB=
NOTION_NEWS_DB=
NOTION_COPY_DB=
NOTION_PROFILE_DB=
NOTION_PLAYER_DB=
NOTION_MATCH_DB=
