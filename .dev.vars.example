# Copy to .dev.vars for local `wrangler dev` / `npm start`.
# This file is an example. Do not put a real password or session secret in git.
# Leave this empty. Do not store a Discord invite pool.
# The owner pastes one invite in the admin approve form. It is emailed once
# and is not written here, in git, or in D1.
DISCORD_INVITE_URL=

# Private admin at admin.localhost / admin.moohsia.com.
# The only username is htw0702. Do not put a password in this file.
# Generate the password hash with `npm run cms:hash`, then paste it here.
# Generate a session secret with `openssl rand -base64 32`.
ADMIN_USERNAME=htw0702
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Notion editorial sync. Leave blank until the owner creates the databases.
# Secrets in production: NOTION_TOKEN, NOTION_WEBHOOK_SECRET, and the database IDs.
# Do not commit a token. Sync writes the CMS draft; it does not publish the site.
NOTION_TOKEN=
NOTION_WEBHOOK_SECRET=
NOTION_ROSTER_DB=
NOTION_NEWS_DB=
NOTION_COPY_DB=
NOTION_PROFILE_DB=
NOTION_PLAYER_DB=
NOTION_MATCH_DB=
NOTION_SEASON_DB=
NOTION_HONOR_DB=
NOTION_TITLE_DB=
NOTION_HERO_DB=

# Mail. Production: wrangler secret put RESEND_API_KEY
# MAIL_FROM defaults to MOOHSIA <Info@moohsia.com> when blank.
# APPLICATIONS_TO defaults to Info@moohsia.com when blank.
RESEND_API_KEY=
MAIL_FROM=
APPLICATIONS_TO=

# Garena gameidsearch session for hourly htw0702aov history.
# Production: wrangler secret put GARENA_ACCESS_TOKEN (and the others).
# Copy localStorage access_token, code, and partition after one login.
# Leave these blank in git. Do not paste a real token here.
# Partition 1012 is 純潔之翼. Omit it to use that default.
# GARENA_CSRF_TOKEN is the csrftoken cookie. The worker also sends it as X-CSRFToken.
GARENA_ACCESS_TOKEN=
GARENA_CODE=
GARENA_PARTITION=
GARENA_CSRF_TOKEN=
